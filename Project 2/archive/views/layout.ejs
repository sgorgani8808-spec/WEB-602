<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/main.css">
  <title>ARCH-IVE</title>
</head>
<body>

<nav class="navbar navbar-expand bg-white border-bottom sticky-top">
  <div class="container-fluid px-3 px-md-4">
    <a class="navbar-brand fw-bold" href="/">ARCH-IVE</a>

    <div class="ms-auto d-flex gap-2 align-items-center">
      <% if (currentUser) { %>
        <a class="btn btn-outline-secondary btn-sm" href="/projects">Projects</a>
        <form action="/auth/logout" method="POST" class="m-0">
          <button class="btn btn-dark btn-sm">Logout</button>
        </form>
      <% } else { %>
        <a class="btn btn-outline-secondary btn-sm" href="/auth/login">Login</a>
        <a class="btn btn-dark btn-sm" href="/auth/signup">Sign up</a>
      <% } %>
    </div>
  </div>
</nav>

<main class="container-fluid px-3 px-md-4 py-4">
  <div class="row justify-content-center">
    <div class="col-12 col-lg-8">
      <%- body %>
    </div>
  </div>
</main>

</body>
</html>