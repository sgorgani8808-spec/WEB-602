<%- include('../layout', { body: `
  <div class="card p-4 shadow-sm">
    <h2 class="h4 mb-3">Create account</h2>

    ${errors.length ? `<div class="alert alert-danger">${errors.map(e=>e.msg).join('<br>')}</div>` : ''}

    <form method="POST" action="/auth/signup">
      <div class="mb-3">
        <label class="form-label">Name</label>
        <input class="form-control" name="name" value="${values.name || ''}" />
      </div>
      <div class="mb-3">
        <label class="form-label">Email</label>
        <input class="form-control" name="email" value="${values.email || ''}" />
      </div>
      <div class="mb-3">
        <label class="form-label">Password</label>
        <input class="form-control" type="password" name="password" />
      </div>
      <button class="btn btn-dark">Sign up</button>
    </form>
    <p class="text-muted small mt-3 mb-0">First user becomes admin automatically.</p>
  </div>
` }) %>