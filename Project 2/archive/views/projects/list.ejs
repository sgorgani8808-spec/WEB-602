<%- include('../layout', { body: `
  <div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="h4 m-0">Projects</h2>
    ${currentUser && currentUser.role === 'admin' ? `<a class="btn btn-dark btn-sm" href="/projects/new">New Project</a>` : ''}
  </div>

  <div class="row g-3">
    ${projects.map(p => `
      <div class="col-12 col-md-6">
        <div class="card p-3 shadow-sm h-100">
          <h3 class="h5 mb-1">${p.title}</h3>
          <div class="text-muted small">${p.location} • ${p.year} • ${p.category}</div>
          <p class="mt-2 mb-0">${(p.description || '').slice(0,120)}...</p>
          <div class="mt-3">
            <a class="btn btn-outline-dark btn-sm" href="/projects/${p._id}">View</a>
          </div>
        </div>
      </div>
    `).join('')}
  </div>
` }) %>