<%- include('../layout', { body: `
  <div class="card shadow-sm my-4">
    <div class="card-body p-4 p-md-5">

      <div class="mb-3">
        <h2 class="h4 mb-1">Edit Project</h2>
        <p class="text-muted small mb-0">Update the project details.</p>
      </div>

      ${errors.length ? `
        <div class="alert alert-danger">
          <div class="fw-semibold mb-1">Please fix the following:</div>
          <ul class="mb-0">
            ${errors.map(e => `<li>${e.msg}</li>`).join('')}
          </ul>
        </div>
      ` : ''}

      <form method="POST" action="/projects/${values._id}?_method=PUT">
        ${formFields(values)}

        <div class="d-flex flex-column flex-sm-row gap-2 mt-4">
          <button class="btn btn-dark w-100">Save</button>
          <a class="btn btn-outline-secondary w-100" href="/projects/${values._id}">Cancel</a>
        </div>
      </form>

    </div>
  </div>
` }) %>

<% function formFields(v){ %>
  <div class="row g-3">

    <div class="col-12">
      <label class="form-label">Title</label>
      <input class="form-control" name="title" value="<%= v.title || '' %>" />
    </div>

    <div class="col-12 col-md-6">
      <label class="form-label">Location</label>
      <input class="form-control" name="location" value="<%= v.location || '' %>" />
    </div>

    <div class="col-12 col-md-6">
      <label class="form-label">Year</label>
      <input class="form-control" type="number" name="year" value="<%= v.year || '' %>" min="1800" max="2100" />
    </div>

    <div class="col-12 col-md-6">
      <label class="form-label">Category</label>
      <input class="form-control" name="category" value="<%= v.category || '' %>" />
    </div>

    <div class="col-12 col-md-6">
      <label class="form-label">Materials</label>
      <input class="form-control" name="materials" value="<%= v.materials || '' %>" />
    </div>

    <div class="col-12">
      <label class="form-label">Description</label>
      <textarea class="form-control" rows="6" name="description"><%= v.description || '' %></textarea>
    </div>

  </div>
<% } %>